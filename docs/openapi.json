{
  "openapi": "3.1.0",
  "info": {
    "title": "Video Grabber automation API",
    "version": "1",
    "description": "Opt-in local API for programs on the same computer. Turn it on in Settings and help → Automation API; the token is shown once. The API accepts only output choices: it cannot set cookies, proxies, referers, folders or page rendering, and cannot read, change or delete Library files. Titles, URLs and error messages in responses come from download sites and should be treated as untrusted text."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}/api/v1",
      "description": "This computer only. The port is shown in Settings and can change if the default is busy.",
      "variables": {
        "port": {
          "default": "8765"
        }
      }
    }
  ],
  "security": [
    {
      "bearerToken": []
    }
  ],
  "paths": {
    "/downloads": {
      "post": {
        "operationId": "queueDownloads",
        "summary": "Add links to the download queue",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DownloadRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted. Links already queued with the same settings are counted as duplicates and not added again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueuedResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "description": "yt-dlp is being updated; try again in a minute.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/jobs/{id}": {
      "get": {
        "operationId": "getJob",
        "summary": "One task's status, progress, error and file names",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The task.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "description": "No task with that id. Finished tasks may have been cleared.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/status": {
      "get": {
        "operationId": "getStatus",
        "summary": "Task counts, pause state and download schedule",
        "responses": {
          "200": {
            "description": "Queue status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "The token starts with vg_. Only its SHA-256 hash is stored by the app."
      }
    },
    "responses": {
      "Error": {
        "description": "400 invalid request, 401 missing or wrong token, 403 API turned off or request not from this computer, 415 body is not application/json.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "DownloadRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "urls"
        ],
        "properties": {
          "urls": {
            "description": "One http(s) link or a list of 1 to 50. Repeated links are queued once.",
            "oneOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "items": {
                  "type": "string",
                  "maxLength": 4096
                }
              }
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "mp4",
              "mp3",
              "original",
              "cover",
              "image"
            ],
            "default": "mp4",
            "description": "mp4 video, mp3 audio, original source audio without re-encoding, a video's cover only, or a direct image."
          },
          "quality": {
            "type": "string",
            "default": "best",
            "description": "best, or a maximum height from 100 to 4320 such as 1080 (a trailing p is accepted)."
          },
          "abr": {
            "type": "integer",
            "enum": [
              96,
              128,
              192,
              256,
              320
            ],
            "default": 192,
            "description": "MP3 bitrate in kbps."
          },
          "no_playlist": {
            "type": "boolean",
            "default": false,
            "description": "Download only the linked video when the link is part of a playlist."
          },
          "subtitles": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "QueuedResponse": {
        "type": "object",
        "required": [
          "ids",
          "duplicates"
        ],
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}$"
            }
          },
          "duplicates": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "url",
          "title",
          "status",
          "stage",
          "percent",
          "error",
          "files"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}$"
          },
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "description": "From the site; untrusted text."
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "done",
              "error",
              "canceled"
            ]
          },
          "stage": {
            "type": "string",
            "description": "Human-readable progress stage."
          },
          "percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "error": {
            "type": "string",
            "description": "Empty unless status is error."
          },
          "files": {
            "type": "array",
            "description": "File names only, never full paths.",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "version",
          "jobs",
          "paused",
          "waiting_for_schedule",
          "next_start"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "const": 1
          },
          "jobs": {
            "type": "object",
            "required": [
              "queued",
              "running",
              "done",
              "error",
              "canceled"
            ],
            "additionalProperties": {
              "type": "integer"
            }
          },
          "paused": {
            "type": "boolean"
          },
          "waiting_for_schedule": {
            "type": "boolean"
          },
          "next_start": {
            "description": "When held by the download schedule, the next start time as Unix seconds; otherwise null.",
            "type": [
              "number",
              "null"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
